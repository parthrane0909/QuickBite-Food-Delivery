      "get": {
        "description": "Current state, items, totals, failure details, version, timestamps \u2014\nowner or admin; other customers receive 404.",
        "operationId": "get_order_api_v1_orders__order_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
