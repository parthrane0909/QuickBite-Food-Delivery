# QuickBite v2.0 — local development configuration template
# Usage: cp .env.example .env  &&  replace every placeholder before starting.
# The real .env is git-ignored. Never commit real secrets.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (authoritative state) ---
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=quickbite
# Used by api/workers inside the Compose network:
DATABASE_URL=postgresql+asyncpg://quickbite:change-me-postgres@postgres:5432/quickbite
# For pytest/alembic run on the HOST instead of inside Compose, use
# (note host port 5433 — see compose.yaml):
# DATABASE_URL=postgresql+asyncpg://quickbite:change-me-postgres@127.0.0.1:5433/quickbite

# --- RabbitMQ (work distribution only; never authoritative) ---
RABBITMQ_DEFAULT_USER=quickbite
RABBITMQ_DEFAULT_PASSWORD=change-me-rabbit
AMQP_URL=amqp://quickbite:change-me-rabbit@rabbitmq:5672/

# --- Authentication (signed, expiring bearer tokens) ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-dev
JWT_ALGORITHM=HS256
JWT_ISSUER=quickbite
JWT_EXPIRY_SECONDS=1800

# --- CORS (explicit origins; no wildcards with credentials) ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000

# --- Health / readiness ---
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# --- Deterministic demo controls (development/test only) -------------
# Applied by worker services from Milestone 3 onward. An ordinary checkout
# request can never select these; they come from environment/protected scripts.
# Values: always_succeed | fail_twice | always_fail | crash_after_checkpoint
PAYMENT_MODE=always_succeed
RESTAURANT_MODE=always_succeed
DELIVERY_MODE=always_succeed
NOTIFICATION_MODE=always_succeed

# --- Simulated per-stage delays (seconds) ---
PAYMENT_DELAY_SECONDS=1
RESTAURANT_DELAY_SECONDS=1
DELIVERY_DELAY_SECONDS=1
NOTIFICATION_DELAY_SECONDS=0

# --- Bounded retry policy: 1 initial attempt + 3 delayed retries -----
RETRY_DELAYS_SECONDS=2,10,30
RETRY_MAX_ATTEMPTS=4

# --- Outbox dispatcher ---
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_LEASE_SECONDS=30

# --- Worker consumers (finite prefetch per channel) --------------------
WORKER_PREFETCH_COUNT=8
